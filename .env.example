APP_NAME=Orro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona horaria usada para determinar el mes financiero actual.
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Firebase Authentication (Google)
# -----------------------------------------------------------------------------
# Estos valores son configuración pública del SDK web. No son secretos, pero
# deben corresponder al proyecto real de Firebase. Ver FIREBASE_SETUP.md.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Opcional: lista separada por comas de correos autorizados.
# Si está vacía, cualquier cuenta de Google verificada por Firebase puede entrar.
FIREBASE_ALLOWED_EMAILS=

# -----------------------------------------------------------------------------
# NativePHP Mobile (Android)
# -----------------------------------------------------------------------------
# Identificador de la app instalable. No cambiar después de publicar.
NATIVEPHP_APP_ID=com.orro.finanzas

# DEBUG re-extrae la app en cada lanzamiento (desarrollo). En release usa una
# versión fija y sube NATIVEPHP_APP_VERSION_CODE.
NATIVEPHP_APP_VERSION=DEBUG
NATIVEPHP_APP_VERSION_CODE=1

# URL de arranque opcional. Vacío usa la raíz (/) de las rutas nativas.
NATIVEPHP_START_URL=
